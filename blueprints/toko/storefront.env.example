# Copy to storefront/.env on the target host.
# Public values may be visible to browsers; keep private values out of NEXT_PUBLIC_*.

NEXT_PUBLIC_BASE_URL=https://{{DOMAIN}}/shop
NEXT_PUBLIC_DEFAULT_REGION=id
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=CHANGE_ME_IF_USED
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=CHANGE_ME_IF_USED
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=CHANGE_ME_IF_USED
NEXT_PUBLIC_STRIPE_KEY=CHANGE_ME_IF_USED
MEDUSA_BACKEND_URL=https://{{DOMAIN}}/shop-api
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=/shop-uploads
REVALIDATE_SECRET=CHANGE_ME_GENERATE_ON_TARGET
